# .env.example
# Add your API keys here. Do not commit the actual .env file.
# For standard OpenAI compatibility or IBM Granite via watsonx / an API gateway

OPENAI_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1  # Or your specific provider's URL
LLM_MODEL_NAME=gpt-4o-mini # Or your chosen IBM Granite model ID

# RAG thresholds
CONFIDENCE_THRESHOLD=0.80
CONFIDENCE_LOW_THRESHOLD=0.50
